-- Script Multifunción para Blox Fruits (Roblox)
-- Incluye: Autofarm, Teleport, ESP de frutas, Speed Hack, y más
-- Úsalo con Synapse X, KRNL o similar

-- IMPORTANTE: Úsalo bajo tu responsabilidad. ¡Puede causar BAN!

-- CONFIGURACIÓN
local Autofarm = true      -- Activar autofarm
local Teleport = true      -- Activar teleports
local ESPFrutas = true     -- Activar ESP de frutas
local SpeedHack = true     -- Activar speed hack

-- FUNCIONES

function autofarm()
    while Autofarm do
        -- Encuentra el enemigo más cercano y ataca
        local enemy = findNearestEnemy()
        if enemy then
            game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = enemy.HumanoidRootPart.CFrame + Vector3.new(0,5,0)
            -- Simula ataque
            fireclickdetector(enemy.ClickDetector)
        end
        wait(0.5)
    end
end

function teleportTo(place)
    if Teleport then
        local locations = {
            ["Ciudad Principal"] = Vector3.new(100, 10, 100),
            ["Jungle"] = Vector3.new(-1100, 50, 400),
            ["Marine Fortress"] = Vector3.new(-4500, 200, 4000),
        }
        if locations[place] then
            game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(locations[place])
        end
    end
end

function espFrutas()
    if ESPFrutas then
        for i,v in pairs(game.Workspace:GetChildren()) do
            if v.Name == "Fruit" then
                -- Marca la fruta en el mapa
                local billboard = Instance.new("BillboardGui", v)
                billboard.Size = UDim2.new(0, 100, 0, 50)
                billboard.AlwaysOnTop = true
                local label = Instance.new("TextLabel", billboard)
                label.Text = "FRUTA AQUI!"
                label.Size = UDim2.new(1,0,1,0)
                label.BackgroundTransparency = 1
                label.TextColor3 = Color3.new(1,0,0)
            end
        end
    end
end

function speedHack(multiplier)
    if SpeedHack then
        game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = 16 * multiplier
    end
end

-- EJEMPLOS DE USO
spawn(autofarm)
teleportTo("Jungle")
espFrutas()
speedHack(3)

